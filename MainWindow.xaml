<Window x:Class="Convertino.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Convertino" Width="720" Height="540" MinWidth="600" MinHeight="420" Background="{DynamicResource WindowBrush}" Foreground="White" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24"><StackPanel><TextBlock Text="Convertino" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Simple, local file conversion for Windows" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="Images work out of the box · audio/video needs ffmpeg on PATH" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Add files" Click="AddFiles_Click" VerticalAlignment="Center"/></DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="14" BorderBrush="#30343D" BorderThickness="1" AllowDrop="True"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Drop files here" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="or choose files to convert locally" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,20"/><Button Content="Choose files" Click="AddFiles_Click" HorizontalAlignment="Center" Padding="20,10"/></StackPanel><ListBox x:Name="FilesList" Visibility="Collapsed" Margin="18" Background="Transparent" BorderThickness="0" Foreground="White"/></Grid></Border>
    <Grid Grid.Row="2" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedBrush}"/><ProgressBar x:Name="ProgressBar" Height="5" Margin="0,10,0,0" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="TargetBox" Width="110" Height="34" Margin="10,0,8,0" VerticalContentAlignment="Center" IsEnabled="False"/><Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Visibility="Collapsed" Padding="14,8"/><Button x:Name="ConvertButton" Content="Convert" Click="Convert_Click" IsEnabled="False" Padding="20,8"/></StackPanel></Grid>
  </Grid>
</Window>
