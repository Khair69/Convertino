<Application x:Class="Convertino.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#101114"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#191B20"/>
    <SolidColorBrush x:Key="CardBrush" Color="#22252C"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9BA1AE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6C8CFF"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F5F7"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#F4F5F7"/><Setter Property="Background" Value="#30343D"/><Setter Property="BorderBrush" Value="#444955"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  </Application.Resources>
</Application>
